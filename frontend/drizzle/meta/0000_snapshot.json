      "checkConstraints": {
        "chk_attendances_status": {
          "name": "chk_attendances_status",
          "value": "\"attendances\".\"status\" in ('off', 'working', 'away', 'done')"
        },
        "chk_attendances_clock_in_style": {
          "name": "chk_attendances_clock_in_style",
          "value": "\"attendances\".\"clock_in_style\" is null or \"attendances\".\"clock_in_style\" in ('office', 'remote', 'direct_visit')"
        },
        "chk_attendances_clock_out_style": {
          "name": "chk_attendances_clock_out_style",
          "value": "\"attendances\".\"clock_out_style\" is null or \"attendances\".\"clock_out_style\" in ('normal', 'direct_return')"
        },
        "chk_attendances_clock_in_pair": {
          "name": "chk_attendances_clock_in_pair",
          "value": "(\"attendances\".\"clock_in_at\" is null and \"attendances\".\"clock_in_style\" is null) or (\"attendances\".\"clock_in_at\" is not null and \"attendances\".\"clock_in_style\" is not null)"
        },
        "chk_attendances_clock_out_pair": {
          "name": "chk_attendances_clock_out_pair",
          "value": "(\"attendances\".\"clock_out_at\" is null and \"attendances\".\"clock_out_style\" is null) or (\"attendances\".\"clock_out_at\" is not null and \"attendances\".\"clock_out_style\" is not null)"
        },
        "chk_attendances_clock_out_requires_clock_in": {
          "name": "chk_attendances_clock_out_requires_clock_in",
          "value": "\"attendances\".\"clock_out_at\" is null or \"attendances\".\"clock_in_at\" is not null"
        },
        "chk_attendances_clock_order": {
          "name": "chk_attendances_clock_order",
          "value": "\"attendances\".\"clock_out_at\" is null or \"attendances\".\"clock_in_at\" <= \"attendances\".\"clock_out_at\""
        },
        "chk_attendances_status_consistency": {
          "name": "chk_attendances_status_consistency",
          "value": "(\n        (\"attendances\".\"status\" = 'off' and \"attendances\".\"clock_in_at\" is null and \"attendances\".\"clock_out_at\" is null) or\n        (\"attendances\".\"status\" = 'working' and \"attendances\".\"clock_in_at\" is not null and \"attendances\".\"clock_out_at\" is null) or\n        (\"attendances\".\"status\" = 'away' and \"attendances\".\"clock_in_at\" is not null and \"attendances\".\"clock_out_at\" is null) or\n        (\"attendances\".\"status\" = 'done' and \"attendances\".\"clock_in_at\" is not null and \"attendances\".\"clock_out_at\" is not null)\n      )"
        }
      },
